# =============================================================================
# Back-Office AI Agent — Environment Configuration
# Copy this file to .env and fill in real keys when switching from sandbox mode
# =============================================================================

# --- Runtime Mode ---
# Set to "sandbox" for out-of-the-box local demo with realistic mock data.
# Set to "live" (or override per-connector below) to call real external APIs.
APP_MODE=sandbox
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_PATH=./data/backoffice_agent.db
CONFIG_DIR=./config

# --- LLM Provider (provider-agnostic) ---
# Options: mock | openai | gemini | anthropic
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1

OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# --- Connector Modes (sandbox | live) ---
EMAIL_MODE=sandbox
SLACK_MODE=sandbox
HRIS_MODE=sandbox
ACCOUNTING_MODE=sandbox
CRM_MODE=sandbox

# --- Email (Gmail / SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=ops-agent@company.example

# --- Slack ---
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APPROVAL_CHANNEL=#ops-approvals
SLACK_ALERTS_CHANNEL=#ops-audit-alerts
SLACK_WEBHOOK_URL=

# --- HRIS (BambooHR) ---
BAMBOOHR_SUBDOMAIN=
BAMBOOHR_API_KEY=

# --- Accounting (Xero) ---
XERO_ACCESS_TOKEN=
XERO_TENANT_ID=

# --- CRM (HubSpot) ---
HUBSPOT_ACCESS_TOKEN=

# --- Server & Dashboard ---
API_HOST=127.0.0.1
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000
STREAMLIT_PORT=8501
